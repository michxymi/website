---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BackLink from "@/components/back-link.astro";
import PageHeader from "@/components/page-header.astro";
import Prose from "@/components/starwind/prose";
import TagList from "@/components/tag-list.astro";
import RootLayout from "@/layouts/root.astro";
import { getBlogPostingStructuredData } from "@/lib/seo";
import { formatLongPostDate } from "@/lib/utils/date";
import { getPostStaticPaths, getReadingTime } from "@/lib/utils/posts";

interface Props {
  post: CollectionEntry<"posts">;
}

export async function getStaticPaths() {
  return await getPostStaticPaths();
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const { data } = post;
const readingTime = getReadingTime(post.body);
const structuredData = getBlogPostingStructuredData(post);
---

<RootLayout
  pageTitle={data.title}
  pageDescription={data.description}
  pageImage={data.coverImage}
  pageImageAlt={data.title}
  pageType="article"
  canonical={`/blog/${post.id}`}
  structuredData={structuredData}
>
  <article>
    <BackLink href="/blog" label="Back to blog" />

    <header class="mb-8">
      <PageHeader title={data.title} />
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3 text-muted-foreground text-sm">
          <time class="font-mono" datetime={data.publishedAt.toISOString()}>
            {formatLongPostDate(data.publishedAt)}
          </time>
          <span class="font-display">{readingTime} min read</span>
        </div>
        <TagList items={data.tags} />
      </div>
    </header>

    <Prose class="max-w-none"> <Content /> </Prose>
  </article>
</RootLayout>
