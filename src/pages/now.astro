---
import GithubChart from "@/components/now/github-chart.astro";
import PageHeader from "@/components/page-header.astro";
import SectionKicker from "@/components/section-kicker.astro";
import {
  Card,
  CardAction,
  CardContent,
  CardHeader,
} from "@/components/starwind/card";
import RootLayout from "@/layouts/root.astro";
import { SOCIAL_LINKS } from "@/lib/social";
import { formatShortPostDate } from "@/lib/utils/date";
import { getRecentPosts } from "@/lib/utils/posts";

const description =
  "A snapshot of what's happening. Before you commit to reading anything else." as const;
const metaDescription =
  "A current snapshot of what Michael Xymitoulias is reading, using, exploring, and building across software engineering, developer tools, and technical leadership." as const;

const uses = [
  { label: "Editor", value: "VSCode" },
  { label: "AI", value: "Codex" },
  { label: "Terminal", value: "Ghostty" },
  { label: "Browser", value: "Google Chrome" },
  { label: "Theme", value: "Dracula Pro" },
  { label: "Infra", value: "Cloudflare" },
  { label: "Sketching", value: "Excalidraw" },
  { label: "Machine", value: 'MacBook Pro 16"' },
] as const;

const posts = await getRecentPosts(3);
const githubLink = SOCIAL_LINKS.find((link) => link.name === "Github");

if (!githubLink) {
  throw new Error("Missing Github social link");
}
---

<RootLayout pageTitle="Now" pageDescription={metaDescription} canonical="/now">
  <PageHeader description={description} title="Now" />

  <div class="space-y-12">
    <Card size="sm" class="bg-transparent">
      <CardHeader>
        <SectionKicker>Uses</SectionKicker>
      </CardHeader>
      <CardContent>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {uses.map(({ label, value }) => (
              <div>
                <div class="text-muted-foreground text-xs">{label}</div>
                <div class="font-display text-sm">{value}</div>
              </div>
            ))}
        </div>
      </CardContent>
    </Card>

    <Card size="sm" class="bg-transparent">
      <CardHeader>
        <SectionKicker>GitHub Activity</SectionKicker>
        <CardAction>
          <a
            class="text-muted-foreground text-xs transition-colors hover:text-foreground"
            href={githubLink.url}
            rel="noopener noreferrer"
            target="_blank"
          >
            {githubLink.description}
            &rarr;
          </a>
        </CardAction>
      </CardHeader>
      <CardContent>
        <div class="overflow-x-auto">
          <GithubChart />
        </div>
      </CardContent>
    </Card>

    {posts.length > 0 && (
      <Card class="bg-transparent" size="sm">
        <CardHeader>
          <SectionKicker>Recent Posts</SectionKicker>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            {posts.map((post, index) => (
              <a class="group flex items-start gap-3" href={`/blog/${post.id}`}>
                <span
                  class:list={[
                    "mt-1 size-2 shrink-0 rounded-full",
                    index === 0
                      ? "bg-primary"
                      : "border border-muted-foreground",
                  ]}
                />
                <div class="min-w-0 flex-1">
                  <div class="text-sm transition-colors group-hover:text-primary">
                    {post.data.title}
                  </div>
                  <time
                    class="text-muted-foreground text-xs"
                    datetime={post.data.publishedAt.toISOString()}
                  >
                    {formatShortPostDate(post.data.publishedAt)}
                  </time>
                </div>
              </a>
            ))}
          </div>
        </CardContent>
      </Card>
    )}
  </div>
</RootLayout>
