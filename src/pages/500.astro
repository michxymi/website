---
import ErrorLayout from "@/layouts/error.astro";
---

<ErrorLayout
  pageTitle="Something broke"
  pageDescription="Something unexpected happened."
  pageRobots="noindex, nofollow"
>
  <p class="mb-4 font-mono text-sm text-muted-foreground">500</p>

  <h1 class="mb-3 font-display text-2xl md:text-3xl">Something broke</h1>

  <p class="mb-8 text-muted-foreground">
    The code did something unexpected. This is not your fault. Well, it might be
    your fault if you sent weird data, but let us assume innocence.
  </p>
</ErrorLayout>
