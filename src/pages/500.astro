---
import SectionKicker from "@/components/section-kicker.astro";
import Button from "@/components/starwind/button";
import RootLayout from "@/layouts/root.astro";
---

<RootLayout
  pageTitle="Something broke"
  pageDescription="Something unexpected happened."
  pageRobots="noindex, nofollow"
>
  <div
    class="flex flex-1 flex-col items-center justify-center py-16 text-center"
  >
    <div class="flex w-full max-w-md flex-col items-center">
      <SectionKicker as="div" class="mb-4">500</SectionKicker>

      <h1 class="mb-3 font-display text-2xl md:text-3xl">Something broke</h1>

      <p class="mb-8 text-muted-foreground">
        The code did something unexpected. This is not your fault. Well, it
        might be your fault if you sent weird data, but let us assume innocence.
      </p>

      <Button href="/"> Go home </Button>
    </div>
  </div>
</RootLayout>
