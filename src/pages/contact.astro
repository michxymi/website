---
import ContactForm from "@/components/contact/form.astro";
import PageHeader from "@/components/page-header.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import RootLayout from "@/layouts/root.astro";
import { SOCIAL_LINKS } from "@/lib/social";

const description =
  "You've read this far. Might as well send a message." as const;
const metaDescription =
  "Contact Michael Xymitoulias for software engineering, technical leadership, developer tools, and web application work." as const;
---

<RootLayout
  canonical="/contact"
  pageDescription={metaDescription}
  pageTitle="Contact"
>
  <PageHeader description={description} title="Contact" />

  <div class="grid gap-6 md:grid-cols-2">
    <ContactForm />

    <Card class="bg-transparent" size="sm">
      <CardHeader>
        <CardTitle class="font-display text-lg">Connect</CardTitle>
        <CardDescription class="line-clamp-2">
          Other ways to find me - if the form felt too formal.
        </CardDescription>
      </CardHeader>
      <CardContent class="space-y-2">
        {SOCIAL_LINKS.map((link) => (
              <a
                class="group flex items-center gap-3 rounded-lg border border-border p-3 transition-colors hover:bg-muted/30"
                href={link.url}
                rel="noopener noreferrer"
                target="_blank"
              >
                <link.icon
                  class="size-5 text-muted-foreground transition-colors group-hover:text-primary"
                />
                <div>
                  <div class="font-display text-sm">{link.name}</div>
                  <div class="text-muted-foreground text-xs">{link.description}</div>
                </div>
              </a>
            ))}
      </CardContent>
    </Card>
  </div>
</RootLayout>
