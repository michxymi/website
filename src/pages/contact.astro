---
import ContactForm from "@/components/contact-form.astro";
import PageHeader from "@/components/page-header.astro";
import SocialLink from "@/components/social-link.astro";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import RootLayout from "@/layouts/root.astro";
import { SOCIAL_LINKS } from "@/lib/social-links";

const description =
  "You've read this far. Might as well send a message." as const;
const metaDescription =
  "Contact Michael Xymitoulias for software engineering, technical leadership, developer tools, and web application work." as const;
---

<RootLayout
  pageTitle="Contact"
  pageDescription={metaDescription}
  canonical="/contact"
>
  <PageHeader description={description} title="Contact" />

  <div class="grid gap-6 md:grid-cols-2">
    <ContactForm />

    <Card size="sm" class="bg-transparent">
      <CardHeader>
        <CardTitle class="font-display text-lg">Connect</CardTitle>
        <CardDescription class="line-clamp-2">
          Other ways to find me - if the form felt too formal.
        </CardDescription>
      </CardHeader>
      <CardContent class="space-y-2">
        {SOCIAL_LINKS.map((link) => (
              <SocialLink  link={link} />
            ))}
      </CardContent>
    </Card>
  </div>
</RootLayout>

<script>
  import { toast } from "@/components/starwind/toast";

  document.addEventListener("contact-form:success", () => {
    toast.success("Message sent", {
      description:
        "Got it. I'll be in touch. Assuming the internet continues to function.",
    });
  });

  document.addEventListener("contact-form:error", () => {
    toast.error("Message didn't send", {
      description:
        "Something broke. Try again. The irony of a contact form preventing contact is not lost on me.",
    });
  });
</script>
