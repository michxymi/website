---
import ErrorLayout from "@/layouts/error.astro";
---

<ErrorLayout
  pageDescription="The page you asked for does not exist."
  pageRobots="noindex, nofollow"
  pageTitle="Page not found"
>
  <p class="mb-4 font-mono text-sm text-muted-foreground">404</p>

  <h1 class="mb-3 font-display text-2xl md:text-3xl">
    This page does not exist
  </h1>

  <p class="mb-8 text-muted-foreground">
    You asked for something that is not here. Maybe it never was. Maybe it was
    and I deleted it. Either way, this is probably enough investigation.
  </p>
</ErrorLayout>
