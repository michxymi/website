---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BackLink from "@/components/back-link.astro";
import PageHeader from "@/components/page-header.astro";
import ProjectLinks from "@/components/project-links.astro";
import Prose from "@/components/starwind/prose";
import TagList from "@/components/tag-list.astro";
import RootLayout from "@/layouts/root.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as Props;
const { Content } = await render(project);
const { data } = project;
---

<RootLayout
  pageTitle={data.title}
  pageDescription={data.description}
  pageImage={data.coverImage}
  pageImageAlt={data.title}
  canonical={`/projects/${project.id}`}
>
  <article>
    <BackLink href="/projects" label="Back to projects" />

    <header class="mb-8">
      <PageHeader title={data.title} description={data.description} />

      <div class="flex flex-col gap-4">
        <TagList items={data.technologies} />

        {(data.repoUrl || data.liveUrl) && (
          <div class="flex flex-wrap justify-end gap-3 text-sm">
            <ProjectLinks liveUrl={data.liveUrl} repoUrl={data.repoUrl} />
          </div>
        )}
      </div>
    </header>

    <Prose class="max-w-none"> <Content /> </Prose>
  </article>
</RootLayout>
