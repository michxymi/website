---
import { getEntry, render } from "astro:content";
import AboutSection from "@/components/about/section.astro";
import SkillsGrid from "@/components/about/skills-grid.astro";
import WorkExperience from "@/components/about/work-experience.astro";
import PageHeader from "@/components/page-header.astro";
import Prose from "@/components/starwind/prose";
import Separator from "@/components/starwind/separator";
import RootLayout from "@/layouts/root.astro";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing content entry: pages/about");
}

const { Content } = await render(about);
const metaDescription =
  "Michael Xymitoulias is a software engineer and engineering manager building developer tools, React applications, Python tooling, and productive software teams." as const;

const LINK_HEADERS = [
  '</feed.xml>; rel="alternate"; type="application/rss+xml"',
  '</blog>; rel="collection"',
  '</.well-known/api-catalog>; rel="api-catalog"',
  '</.well-known/openid-configuration>; rel="openid-configuration"',
  '</.well-known/oauth-authorization-server>; rel="oauth-authorization-server"',
  '</.well-known/oauth-protected-resource>; rel="oauth-protected-resource"',
  '</.well-known/mcp/server-card.json>; rel="mcp-server-card"',
  '</.well-known/agent-skills/index.json>; rel="agent-skills"',
] as const;

Astro.response.headers.set("Link", LINK_HEADERS.join(", "));
---

<RootLayout pageTitle="About" pageDescription={metaDescription} canonical="/">
  <PageHeader description={about.data.description} title={about.data.title} />

  <AboutSection class="mb-12" title="Bio">
    <Prose class="max-w-none text-sm md:text-base"> <Content /> </Prose>
  </AboutSection>

  <Separator class="my-8" />

  <AboutSection class="mb-12" title="Skills & Technologies">
    <SkillsGrid />
  </AboutSection>

  <Separator class="my-8" />

  <AboutSection title="Experience"> <WorkExperience /> </AboutSection>
</RootLayout>
