---
import { getEntry, render } from "astro:content";
import AboutSection from "@/components/about-section.astro";
import PageHeader from "@/components/page-header.astro";
import SkillsGrid from "@/components/skills-grid.astro";
import Prose from "@/components/starwind/prose";
import Separator from "@/components/starwind/separator";
import WorkExperience from "@/components/work-experience.astro";
import RootLayout from "@/layouts/root.astro";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing content entry: pages/about");
}

const { Content } = await render(about);
---

<RootLayout>
  <PageHeader description={about.data.description} title={about.data.title} />

  <AboutSection title="Bio">
    <Prose class="max-w-none text-sm md:text-base"> <Content /> </Prose>
  </AboutSection>

  <Separator class="my-8" />

  <AboutSection title="Skills & Technologies"> <SkillsGrid /> </AboutSection>

  <Separator class="my-8" />

  <AboutSection title="Experience"> <WorkExperience /> </AboutSection>
</RootLayout>
