---
import { getEntry, render } from "astro:content";
import PageHeader from "@/components/page-header.astro";
import SkillsGrid from "@/components/skills-grid.astro";
import Prose from "@/components/starwind/prose";
import Separator from "@/components/starwind/separator";
import RootLayout from "@/layouts/root.astro";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing content entry: pages/about");
}

const { Content } = await render(about);
---

<RootLayout>
  <div>
    <PageHeader description={about.data.description} title={about.data.title} />

    <section class="mb-12">
      <h2 class="mb-4 font-display text-lg">Bio</h2>
      <Prose class="max-w-none"> <Content /> </Prose>
    </section>

    <Separator class="my-8" />

    <section class="mb-12">
      <h2 class="mb-6 font-display text-lg">Skills & Technologies</h2>
      <SkillsGrid />
    </section>

    <Separator class="my-8" />

    <section>
      <h2 class="mb-6 font-display text-lg">Experience</h2>
      <!-- <WorkExperience experiences={experiences} /> -->
    </section>
  </div>
</RootLayout>
