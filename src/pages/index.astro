---
import { getEntry, render } from "astro:content";
import PageHeader from "@/components/page-header.astro";
import SkillsGrid from "@/components/skills-grid.astro";
import Prose from "@/components/starwind/prose";
import Separator from "@/components/starwind/separator";
import WorkExperience from "@/components/work-experience.astro";
import RootLayout from "@/layouts/root.astro";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing content entry: pages/about");
}

const { Content } = await render(about);
---

<RootLayout>
  <div>
    <PageHeader description={about.data.description} title={about.data.title} />

    <section class="mb-12">
      <h2
        class="mb-4 font-mono font-medium text-muted-foreground text-xs uppercase"
      >
        Bio
      </h2>
      <Prose class="max-w-none text-sm md:text-base"> <Content /> </Prose>
    </section>

    <Separator class="my-8" />

    <section class="mb-12">
      <h2
        class="mb-6 font-mono font-medium text-muted-foreground text-xs uppercase"
      >
        Skills & Technologies
      </h2>
      <SkillsGrid />
    </section>

    <Separator class="my-8" />

    <section>
      <h2
        class="mb-6 font-mono font-medium text-muted-foreground text-xs uppercase"
      >
        Experience
      </h2>
      <WorkExperience />
    </section>
  </div>
</RootLayout>
