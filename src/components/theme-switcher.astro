---
import Moon from "@tabler/icons/outline/moon.svg";
import Sun from "@tabler/icons/outline/sun.svg";

import { Toggle } from "@/components/starwind/toggle";

interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---

<Toggle
  size="sm"
  class:list={[
    "group text-muted-foreground hover:bg-transparent hover:text-foreground",
    "data-[state=on]:bg-transparent data-[state=on]:text-muted-foreground data-[state=on]:hover:bg-transparent data-[state=on]:hover:text-foreground",
    className,
  ]}
  aria-label="Toggle theme"
  data-theme-toggle
>
  <span class="size-4" data-theme-icon-wrapper>
    <Sun
      class="hidden size-4 group-data-[state=off]:data-ready:block"
      data-theme-icon
    />
    <Moon
      class="hidden size-4 group-data-[state=on]:data-ready:block"
      data-theme-icon
    />
  </span>
</Toggle>

<script>
  import type { ToggleChangeEvent } from "@/components/starwind/toggle";

  const themeToggleSelector = "[data-theme-toggle]" as const;

  const syncToggleState = (toggle: HTMLButtonElement) => {
    const isDark = document.documentElement.classList.contains("dark");

    toggle.setAttribute("data-state", isDark ? "on" : "off");
    toggle.setAttribute("aria-pressed", isDark.toString());

    for (const icon of toggle.querySelectorAll("[data-theme-icon]")) {
      icon.setAttribute("data-ready", "");
    }
  };

  const setupThemeToggle = (toggle: HTMLButtonElement) => {
    syncToggleState(toggle);

    if (toggle.dataset.themeToggleReady) {
      return;
    }

    toggle.dataset.themeToggleReady = "true";

    toggle.addEventListener("starwind-toggle:change", (event: Event) => {
      const { pressed } = (event as ToggleChangeEvent).detail;

      document.documentElement.classList.toggle("dark", pressed);
      localStorage.setItem("colorTheme", pressed ? "dark" : "light");
      syncToggleState(toggle);
    });
  };

  const setupThemeToggles = () => {
    for (const toggle of document.querySelectorAll<HTMLButtonElement>(
      themeToggleSelector
    )) {
      setupThemeToggle(toggle);
    }
  };

  setupThemeToggles();
  document.addEventListener("astro:after-swap", setupThemeToggles);
  document.addEventListener("starwind:init", () => setupThemeToggles());
</script>
