---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import JsonLd from "@/components/seo/json-ld.astro";
import Person from "@/components/seo/person.astro";
import Website from "@/components/seo/website.astro";
import type { JsonLdData } from "@/lib/seo";
import { SEO_CONFIG } from "@/lib/seo";

interface Props {
  canonical?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  structuredData?: JsonLdData | JsonLdData[];
  title?: string;
  type?: "article" | "profile" | "website";
}

const {
  canonical = Astro.url.pathname,
  description = SEO_CONFIG.description,
  image = SEO_CONFIG.ogImage,
  imageAlt,
  robots = "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1",
  structuredData,
  title,
  type = "website",
} = Astro.props as Props;

const pageTitle = title ? `${title} | ${SEO_CONFIG.name}` : SEO_CONFIG.name;
const canonicalUrl = new URL(canonical, SEO_CONFIG.url).toString();
const feedUrl = new URL("/feed.xml", SEO_CONFIG.url).toString();
const imageUrl = new URL(image, SEO_CONFIG.url).toString();
const socialImageAlt = imageAlt ?? title ?? SEO_CONFIG.name;
let structuredDataItems: JsonLdData[] = [];

if (Array.isArray(structuredData)) {
  structuredDataItems = structuredData;
} else if (structuredData) {
  structuredDataItems = [structuredData];
}
---

<head>
  <meta charset="utf-8">
  <link href="/favicon.svg" rel="icon" type="image/svg+xml">
  <link href="/favicon.ico" rel="icon">
  <link href="/sitemap-index.xml" rel="sitemap">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content={Astro.generator} name="generator">
  <Font
    cssVariable="--font-ibm-plex-sans"
    preload={[{ style: "normal", weight: 400 }]}
  />
  <Font cssVariable="--font-jetbrains-mono" />

  <title>{pageTitle}</title>
  <meta content={description} name="description">
  <meta content={SEO_CONFIG.author.name} name="author">
  <meta content={SEO_CONFIG.author.name} name="creator">
  <meta content={robots} name="robots">

  <link href={canonicalUrl} rel="canonical">
  <link
    href={feedUrl}
    rel="alternate"
    title={`${SEO_CONFIG.name} Blog`}
    type="application/rss+xml"
  >

  <meta content={type} property="og:type">
  <meta content={SEO_CONFIG.locale} property="og:locale">
  <meta content={canonicalUrl} property="og:url">
  <meta content={SEO_CONFIG.name} property="og:site_name">
  <meta content={pageTitle} property="og:title">
  <meta content={description} property="og:description">
  <meta content={imageUrl} property="og:image">
  <meta content="1200" property="og:image:width">
  <meta content="630" property="og:image:height">
  <meta content={socialImageAlt} property="og:image:alt">

  <meta content="summary_large_image" name="twitter:card">
  <meta content={SEO_CONFIG.author.twitter} name="twitter:site">
  <meta content={SEO_CONFIG.author.twitter} name="twitter:creator">
  <meta content={pageTitle} name="twitter:title">
  <meta content={description} name="twitter:description">
  <meta content={imageUrl} name="twitter:image">

  <Person />
  <Website />
  <ClientRouter />

  {structuredDataItems.map((data) => <JsonLd data={data} />)}
  <script is:inline>
    function prefersDarkTheme() {
      return (
        window.matchMedia?.("(prefers-color-scheme: dark)")?.matches ?? false
      );
    }

    function initTheme() {
      const colorTheme = localStorage.getItem("colorTheme");

      if (colorTheme === "dark") {
        document.documentElement.classList.add("dark");
        return;
      }

      if (colorTheme === "light") {
        document.documentElement.classList.remove("dark");
        return;
      }

      if (colorTheme === "system") {
        document.documentElement.classList.toggle("dark", prefersDarkTheme());
        return;
      }

      if (prefersDarkTheme()) {
        document.documentElement.classList.add("dark");
        localStorage.setItem("colorTheme", "dark");
        return;
      }

      document.documentElement.classList.remove("dark");
      localStorage.setItem("colorTheme", "light");
    }

    // runs on initial page load
    initTheme();

    // runs on view transitions navigation
    document.addEventListener("astro:after-swap", initTheme);
  </script>
</head>
