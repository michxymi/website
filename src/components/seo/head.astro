---
import { Font } from "astro:assets";
import JsonLd from "@/components/seo/json-ld.astro";
import Person from "@/components/seo/person.astro";
import Website from "@/components/seo/website.astro";
import { SEO_CONFIG } from "@/lib/seo";
import type { JsonLdData } from "@/lib/structured-data";

interface Props {
  canonical?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  structuredData?: JsonLdData | JsonLdData[];
  title?: string;
  type?: "article" | "profile" | "website";
}

const {
  canonical = Astro.url.pathname,
  description = SEO_CONFIG.description,
  image = SEO_CONFIG.ogImage,
  imageAlt,
  robots = "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1",
  structuredData,
  title,
  type = "website",
} = Astro.props as Props;

const pageTitle = title ? `${title} | ${SEO_CONFIG.name}` : SEO_CONFIG.name;
const canonicalUrl = new URL(canonical, SEO_CONFIG.url).toString();
const feedUrl = new URL("/feed.xml", SEO_CONFIG.url).toString();
const imageUrl = new URL(image, SEO_CONFIG.url).toString();
const socialImageAlt = imageAlt ?? title ?? SEO_CONFIG.name;
let structuredDataItems: JsonLdData[] = [];

if (Array.isArray(structuredData)) {
  structuredDataItems = structuredData;
} else if (structuredData) {
  structuredDataItems = [structuredData];
}
---

<head>
  <meta charset="utf-8">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" href="/favicon.ico">
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator}>
  <Font
    cssVariable="--font-ibm-plex-sans"
    preload={[{ weight: 400, style: "normal" }]}
  />
  <Font cssVariable="--font-jetbrains-mono" />

  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SEO_CONFIG.author.name}>
  <meta name="creator" content={SEO_CONFIG.author.name}>
  <meta name="robots" content={robots}>

  <link rel="canonical" href={canonicalUrl}>
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${SEO_CONFIG.name} Blog`}
    href={feedUrl}
  >

  <meta property="og:type" content={type}>
  <meta property="og:locale" content={SEO_CONFIG.locale}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content={SEO_CONFIG.name}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={imageUrl}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={socialImageAlt}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content={SEO_CONFIG.author.twitter}>
  <meta name="twitter:creator" content={SEO_CONFIG.author.twitter}>
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>

  <Person />
  <Website />
  {structuredDataItems.map((data) => <JsonLd data={data} />)}
  <script is:inline>
    function prefersDarkTheme() {
      return (
        window.matchMedia?.("(prefers-color-scheme: dark)")?.matches ?? false
      );
    }

    function initTheme() {
      const colorTheme = localStorage.getItem("colorTheme");

      if (colorTheme === "dark") {
        document.documentElement.classList.add("dark");
        return;
      }

      if (colorTheme === "light") {
        document.documentElement.classList.remove("dark");
        return;
      }

      if (colorTheme === "system") {
        document.documentElement.classList.toggle("dark", prefersDarkTheme());
        return;
      }

      if (prefersDarkTheme()) {
        document.documentElement.classList.add("dark");
        localStorage.setItem("colorTheme", "dark");
        return;
      }

      document.documentElement.classList.remove("dark");
      localStorage.setItem("colorTheme", "light");
    }

    // runs on initial page load
    initTheme();

    // runs on view transitions navigation
    document.addEventListener("astro:after-swap", initTheme);
  </script>
</head>
