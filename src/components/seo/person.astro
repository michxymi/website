---
import JsonLd from "@/components/seo/json-ld.astro";
import { SEO_CONFIG } from "@/lib/seo";

const schema = {
  "@context": "https://schema.org",
  "@id": `${SEO_CONFIG.url}/#person`,
  "@type": "Person",
  alternateName: "michxymi",
  description:
    "Full Stack Software Engineer and Engineering Manager with expertise in developer tools, web applications, and technical leadership.",
  jobTitle: SEO_CONFIG.author.jobTitle,
  knowsAbout: [
    "Software Engineering",
    "Technical Leadership",
    "Developer Tools",
    "React",
    "Typescript",
    "Python",
    "C++",
    "NextJS",
  ],
  name: SEO_CONFIG.author.name,
  sameAs: SEO_CONFIG.socialProfileUrls,
  url: SEO_CONFIG.url,
  worksFor: {
    "@type": "Organization",
    name: SEO_CONFIG.author.worksFor,
  },
} as const;
---

<JsonLd data={schema} />
