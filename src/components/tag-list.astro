---
import { Badge } from "@/components/starwind/badge";

interface Props {
  badgeClass?: string;
  class?: string;
  gap?: "sm" | "md";
  hiddenCountClass?: string;
  items: readonly string[];
  limit?: number;
}

const {
  badgeClass = "font-mono text-xs",
  class: className,
  gap = "md",
  hiddenCountClass = "px-1 text-muted-foreground text-xs",
  items,
  limit,
} = Astro.props as Props;

const visibleItems = typeof limit === "number" ? items.slice(0, limit) : items;
const hiddenCount = items.length - visibleItems.length;
const gapClass = gap === "sm" ? "gap-1" : "gap-2";
---

{items.length > 0 && (
  <div class:list={["flex flex-wrap", gapClass, className]}>
    {visibleItems.map((item) => (
      <Badge class={badgeClass} variant="secondary">
        {item}
      </Badge>
    ))}
    {hiddenCount > 0 && (
      <span class={hiddenCountClass}>+{hiddenCount}</span>
    )}
  </div>
)}
