---
import Badge from "@/components/starwind/badge";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";

const skillCategories = [
  {
    title: "Languages",
    skills: ["Typescript", "Javascript", "Python", "Go", "C++", "C"],
  },
  {
    title: "Frontend & Desktop",
    skills: ["React", "NextJS", "Electron", "Tailwind CSS", "HTML/CSS"],
  },
  {
    title: "Backend",
    skills: ["NodeJS", "PostgreSQL", "Redis", "REST", "gRPC"],
  },
  {
    title: "DevOps & Tooling",
    skills: [
      "Docker",
      "GitLab CI",
      "Github Actions",
      "AWS",
      "Vercel",
      "Cloudflare",
    ],
  },
] as const;
---

<div class="grid gap-4 sm:grid-cols-2">
  {skillCategories.map((category) => (
            <Card class="bg-transparent py-4">
                <CardHeader class="pb-2">
                    <CardTitle class="font-medium font-mono text-muted-foreground text-xs uppercase">
                        {category.title}
                    </CardTitle>
                </CardHeader>
                <CardContent>
                    <div class="flex flex-wrap gap-2">
                        {category.skills.map((skill) => (
                            <Badge
                                class="font-mono text-xs"
                                variant="secondary"
                            >
                                {skill}
                            </Badge>
                        ))}
                    </div>
                </CardContent>
            </Card>
        ))}
</div>
