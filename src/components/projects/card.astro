---
import type { CollectionEntry } from "astro:content";
import ProjectLinks from "@/components/projects/links.astro";
import {
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
  Card as StarwindCard,
} from "@/components/starwind/card";
import TagList from "@/components/tag-list.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;
const { data } = project;
---

<article class="group h-full">
  <StarwindCard
    size="sm"
    class="relative h-full transition-colors hover:bg-muted/50 bg-transparent"
  >
    <a
      aria-label={`Open ${data.title}`}
      class="absolute inset-0 z-10 rounded-xl focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-outline/50"
      href={`/projects/${project.id}`}
    >
      <span class="sr-only">Open {data.title}</span>
    </a>

    <CardHeader>
      <CardTitle
        class="font-display text-lg transition-colors group-hover:text-primary"
      >
        {data.title}
      </CardTitle>
      <CardDescription class="line-clamp-2">
        {data.description}
      </CardDescription>
    </CardHeader>

    {data.technologies.length > 0 && (
      <CardContent>
        <TagList gap="sm" items={data.technologies} limit={4} />
      </CardContent>
    )}

    {(data.repoUrl || data.liveUrl) && (
      <CardFooter class="relative z-20 mt-auto justify-end gap-3 border-t-0 bg-transparent pt-0">
        <ProjectLinks
          iconClass="size-3.5"
          liveUrl={data.liveUrl}
          repoUrl={data.repoUrl}
        />
      </CardFooter>
    )}
  </StarwindCard>
</article>
