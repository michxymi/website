---
import type GithubIcon from "@tabler/icons/outline/brand-github.svg";
import type LinkedInIcon from "@tabler/icons/outline/brand-linkedin.svg";
import type XIcon from "@tabler/icons/outline/brand-x.svg";

interface SocialLink {
  description?: string;
  icon: typeof GithubIcon | typeof LinkedInIcon | typeof XIcon;
  name: string;
  url: string;
}

interface Props {
  link: SocialLink;
}

const { link } = Astro.props as Props;
---

<a
  class="group flex items-center gap-3 rounded-lg border border-border p-3 transition-colors hover:bg-muted/30"
  href={link.url}
  rel="noopener noreferrer"
  target="_blank"
>
  <link.icon
    class="size-5 text-muted-foreground transition-colors group-hover:text-primary"
  />
  <div>
    <div class="font-display text-sm">{link.name}</div>
    <div class="text-muted-foreground text-xs">{link.description}</div>
  </div>
</a>
