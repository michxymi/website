{
  "name": "@michxymi/website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "analyze": "node scripts/analyze-bundle.mjs",
    "astro": "astro",
    "build": "pnpm build:og && astro build",
    "build:og": "node scripts/opengraph/generate.ts",
    "check": "ultracite check",
    "deploy": "pnpm build && wrangler deploy --config wrangler.deploy.jsonc",
    "dev": "astro dev",
    "fix": "ultracite fix",
    "generate-types": "wrangler types",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "typecheck": "pnpm typecheck:astro && pnpm typecheck:ts",
    "typecheck:astro": "astro check",
    "typecheck:ts": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "vite": "^7"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "astro-expressive-code": "^0.44.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.11",
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.4.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.12",
    "rollup-plugin-visualizer": "^7.1.1",
    "satori": "^0.33.4",
    "typescript": "^6",
    "ultracite": "7.11.0",
    "wrangler": "^4.129.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11.0"
  }
}
