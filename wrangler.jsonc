{
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
